{
  "name": "alicesim",
  "version": "0.2.0",
  "private": true,
  "description": "Cross-platform STM32 firmware and circuit simulator",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "web:build": "node scripts/build-web.mjs",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "pnpm sidecar:build && tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1"
}
